# Copy to .env next to docker-compose.yml and fill in. Generate each secret with:
#   openssl rand -hex 32

# The API's public host name (an A record pointing at this server). No https://, no path.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILES_URL_SECRET=
# Encrypts stored Zoom/Google tokens: never change it once teachers have connected accounts.
INTEGRATIONS_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_SESSION_TTL_HOURS=24
MAX_OWNED_CENTERS=3
TRIAL_PLAN_CODE=BASIC
LIBRARY_MAX_FILE_MB=1024
SWAGGER_ENABLED=false

# The web app (e.g. on Vercel): emails link to APP_URL; CORS_ORIGIN is comma-separated origins.
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# First start only: creates the platform operator account when none exists.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin

# Email (empty SMTP_HOST: emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Edu Platform <no-reply@example.com>"

# Zoom / Google Meet (optional). Redirect URIs: https://<API_DOMAIN>/api/integrations/{zoom,google}/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
