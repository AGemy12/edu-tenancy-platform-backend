PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/edu_platform?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
# Centers one account may own (each new center starts a free trial; only one running trial at a time).
MAX_OWNED_CENTERS=3
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL_DAYS=30            # "remember me" sessions
JWT_REFRESH_SESSION_TTL_HOURS=24   # sessions without "remember me"

CORS_ORIGIN=http://localhost:3000
# Behind a reverse proxy, how many hops to trust so rate limits see the client IP (e.g. 1)
TRUST_PROXY=
# API docs at /api/docs are off in production unless this is true
SWAGGER_ENABLED=
APP_URL=http://localhost:3000      # used in emails (password reset links)

# SMTP (leave SMTP_HOST empty in development: emails are logged to the console
# and the reset link is returned by the API)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="منصة إدارة الطلاب <no-reply@example.com>"

# Zoom: one OAuth "General app" (user-managed) on https://marketplace.zoom.us. Each teacher connects
# their own Zoom account from Settings. Scopes: meeting:write:meeting, meeting:update:meeting,
# meeting:delete:meeting, meeting:read:meeting, user:read:user. Event subscription URL:
# <API>/api/zoom/webhook with meeting.started, meeting.ended, meeting.participant_joined and app deauthorized.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4000/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=          # app > Features > Secret Token; enables live status and MISSED detection

# Google Meet via Calendar API (OAuth 2.0 client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Encrypts stored Zoom/Google OAuth tokens (falls back to JWT_ACCESS_SECRET; set it in production
# and never rotate JWT_ACCESS_SECRET without it, or connected accounts must reconnect)
INTEGRATIONS_SECRET=

# First run only: creates the platform operator account when none exists (then can be removed)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin

# Library (teacher files)
STORAGE_DIR=storage                # local disk storage, relative to backend/
LIBRARY_MAX_FILE_MB=1024           # absolute upload ceiling; each package (Plan.maxFileMb) sets its own lower limit
TRIAL_PLAN_CODE=BASIC              # package new centers get during their trial
FILES_URL_SECRET=change-me-files-secret   # signs short-lived file links (falls back to JWT_ACCESS_SECRET)
